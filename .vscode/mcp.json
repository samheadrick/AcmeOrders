{
  "servers": {
    "endor-cli-tools": {
      "command": "npx",
      "args": [
        "-y",
        "endorctl",
        "ai-tools",
        "mcp-server",
        "--config-path",
        ".endorctl-mcp"
      ],
      "env": {
        "MCP_ENDOR_CONFIG_PATH": ".endorctl-mcp",
        "ENDOR_MCP_SERVER_AUTH_MODE": "google",
        "ENDOR_API": "https://api.staging.endorlabs.com",
        "ENDOR_NAMESPACE": "testing-tenant.mcp"
      }
    }
  }
}